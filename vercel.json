{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:phone && npm run build:bundle",
  "outputDirectory": "public",
  "functions": {
    "api/ephemeris.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
